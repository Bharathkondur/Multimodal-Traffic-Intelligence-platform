# Multi-stage build for backend service
FROM python:3.11-slim as base

# Install system dependencies required for OpenCV, model processing, and utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    gcc \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Stage 2: Builder
FROM base as builder

# Copy all requirements files
COPY backend/requirements.txt .
COPY backend/agents/requirements.txt ./agents/requirements.txt

# Install Python dependencies
RUN pip install --user --no-cache-dir -r requirements.txt

# Stage 3: Model Download
FROM builder as model-downloader

# Download YOLOv8 model for object detection
RUN pip install --user --no-cache-dir ultralytics
RUN python3 -c "from ultralytics import YOLO; print('Downloading YOLOv8n...'); YOLO('yolov8n.pt'); print('✓ Model downloaded')" || echo "Model download attempted"

# Stage 4: Runtime
FROM base as runtime

# Create non-root user
RUN useradd -m -u 1000 appuser

# Copy Python dependencies from builder
COPY --from=builder /root/.local /home/appuser/.local

# Copy pre-downloaded models
COPY --from=model-downloader /root/.cache /home/appuser/.cache

# Copy entire backend directory structure with all modules
COPY backend/ .

# Create necessary directories
RUN mkdir -p /app/models /app/uploads /app/logs && \
    chown -R appuser:appuser /app

# Set environment variables
USER appuser
ENV PATH=/home/appuser/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:$PYTHONPATH

# Expose API port
EXPOSE 8000

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Start FastAPI server with proper worker settings
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
