# Database Configuration
DB_USER=traffic_admin
DB_PASSWORD=secure_password_change_me
DB_NAME=traffic_intelligence
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_PASSWORD=redis_password_change_me
REDIS_HOST=redis
REDIS_PORT=6379

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=False

# LLM Provider — choose one: gemini | openai | ollama
# Gemini 2.0 Flash is FREE (1,500 req/day). Get key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (alternative) — comment out Gemini above and use this instead
OPENAI_API_KEY=sk-your-api-key-here

# Ollama (local, no internet needed) — run: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# YOLO Model Configuration
YOLO_MODEL_PATH=/app/models/yolov8n.pt
YOLO_MODEL_SIZE=n
DETECTION_CONFIDENCE=0.5
DETECTION_IOU_THRESHOLD=0.45
MAX_DETECTIONS_PER_FRAME=100

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# File Upload Configuration
UPLOAD_MAX_SIZE=104857600
UPLOAD_DIR=/app/uploads
ALLOWED_EXTENSIONS=[".mp4", ".avi", ".mov", ".mkv", ".png", ".jpg", ".jpeg"]

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password_change_me

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30

# Video Processing
FRAME_SKIP_RATE=2
VIDEO_PROCESSING_QUEUE_SIZE=100
MAX_CONCURRENT_VIDEOS=3

# Monitoring & Metrics
METRICS_ENABLED=True
METRICS_PORT=9090
TELEMETRY_ENABLED=True

# Security
JWT_SECRET=your_jwt_secret_key_change_me
SESSION_TIMEOUT=3600
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Email Notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
ALERT_EMAIL_RECIPIENTS=[]

# S3/Object Storage (optional)
S3_ENABLED=False
S3_BUCKET=traffic-intelligence
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Feature Flags
ENABLE_VIDEO_PROCESSING=True
ENABLE_REAL_TIME_ANALYSIS=True
ENABLE_INCIDENT_DETECTION=True
ENABLE_TRAFFIC_FLOW_ANALYSIS=True
ENABLE_PREDICTIVE_ANALYTICS=False
